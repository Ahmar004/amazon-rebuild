# Copy to .env.local and fill in. Never commit .env.local.
# Neon pooled connection string (main branch)
DATABASE_URL=
# Neon pooled connection string (test branch), for data-layer tests only
DATABASE_URL_TEST=
# Random 64-hex-character string that signs cookies: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Stripe test-mode keys (pk_test_..., sk_test_...)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Vercel Blob read-write token for listing photos. The store must be created with Public access.
BLOB_READ_WRITE_TOKEN=
